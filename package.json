{
  "name": "ai-ops-board",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "validate:env": "python scripts/validate_env.py",
    "smoke:api": "python scripts/smoke_api.py",
    "smoke:api:deep": "python scripts/smoke_api.py --deep",
    "smoke:api:deep:only": "python scripts/smoke_api.py --deep --deep-only",
    "release:checks": "npm run validate:env && npm run build && python -m compileall backend",
    "release:full": "npm run release:checks && npm run smoke:api",
    "release:full:deep": "npm run release:checks && npm run smoke:api:deep",
    "docker:build": "docker build -t ai-ops-board .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker": "docker-compose up --build"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.11.0",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "postcss": "^8.5.12",
    "tailwindcss": "^3.4.19",
    "typescript": "^5"
  }
}
