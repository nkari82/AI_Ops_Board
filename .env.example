# AI Ops Board Environment Variables

# Copy this file to .env and fill in the values

# === Port Configuration ===
FRONTEND_PORT=3005
BACKEND_PORT=8005
POSTGRES_PORT=5432

# Reddit API (https://www.reddit.com/prefs/apps)
# Create app: https://www.reddit.com/prefs/apps
# Select "script" type for personal use

# === Reddit App Registration Details ===
# App Name: AI Ops Board
# Description (앱 설명):
#   "Personal project to aggregate AI operation tips from Reddit/GitHub/HN
#    for self-learning. Non-commercial, no ads, no data reselling.
#    Posts are stored locally and used only for personal reference."
# About URL: (your project URL or leave empty)
# Redirect URI: http://localhost:8080

# === Reddit API Mode (requires approval) ===
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=AI-Ops-Board/1.0 (by /u/your_username)

# === Reddit RSS Mode (no approval needed) ===
# Set to True to use RSS feeds instead of API
# RSS works immediately without Reddit approval
REDDIT_USE_RSS=True
REDDIT_RSS_FEEDS=https://www.reddit.com/r/LocalLLaMA/.rss,https://www.reddit.com/r/ArtificialInteligence/.rss
# RSS 정밀 파싱 제어 (HTML 정제/링크 원문 병합)
REDDIT_RSS_MAX_CONTENT_CHUNKS=4
REDDIT_RSS_MAX_LINKS_PER_ENTRY=2
REDDIT_RSS_FETCH_LINK_CONTENT=true
REDDIT_RSS_LINK_TIMEOUT_SECONDS=6
REDDIT_RSS_MAX_LINK_CONTENT_CHARS=1200
REDDIT_RSS_SELFTEXT_MAX_CHARS=4000
# 링크 원문 품질 게이트
REDDIT_RSS_LINK_MIN_TEXT_CHARS=160
REDDIT_RSS_LINK_MAX_NOISE_RATIO=0.45
REDDIT_RSS_LINK_MAX_SAME_LINE_RATIO=0.6

# Crawl source control
# Only listed sources are allowed to run (API + scheduled tasks)
# Available: reddit, github, hn, youtube, geeknews
CRAWL_ENABLED_SOURCES=reddit,github,hn,youtube,geeknews

# YouTube allowed target list (comma-separated URLs)
# Harness 운영 기본값: AI/LLM 운영 관련 공식 채널 3종
YOUTUBE_TARGET_URLS=https://www.youtube.com/@OpenAI,https://www.youtube.com/@GoogleDevelopers,https://www.youtube.com/@huggingface
# Strict mode default: false이면 빈 allow-list에서 /crawl/youtube 호출이 차단됩니다.
# true일 때만 빈 allow-list를 unrestricted로 허용합니다.
YOUTUBE_ALLOW_ALL_WHEN_TARGETS_EMPTY=false
# 키워드 기반 자동 검색/스크롤(다건 수집) 제어
YOUTUBE_SEARCH_ENABLED=true
YOUTUBE_SEARCH_MAX_RESULTS=8
YOUTUBE_SEARCH_MAX_PAGES=2
# Dedup 활성 유지 시간(초): 동일 query/max/pages active task 공유
YOUTUBE_SEARCH_DEDUP_TTL_SECONDS=900
# 동일 dedup key 요청 rate-limit
YOUTUBE_SEARCH_RATE_LIMIT_WINDOW_SECONDS=60
YOUTUBE_SEARCH_RATE_LIMIT_MAX_REQUESTS=5

# GeekNews (https://news.hada.io)
GEEKNEWS_RSS_URL=https://news.hada.io/rss/news

# Minimal text thresholds for reliable LLM classification
MIN_CLASSIFIABLE_CONTENT_LEN=120
MIN_CLASSIFIABLE_SIGNAL_LEN=160

# LLM Providers

## Hugging Face (https://huggingface.co/settings/inference)
## Free tier - No GPU needed
HUGGINGFACE_TOKEN=your_huggingface_token

## Groq (https://console.groq.com/)
## Free tier available
GROQ_API_KEY=your_groq_api_key

## OpenRouter (https://openrouter.ai/keys)
## 29+ free models (:free) fallback hub
OPENROUTER_API_KEY=your_openrouter_api_key

## Mistral AI (https://console.mistral.ai/) - generous free/experiment tier
MISTRAL_API_KEY=your_mistral_api_key
MISTRAL_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

## DeepSeek (https://platform.deepseek.com/) - trial/free credits
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

## Cerebras (https://cloud.cerebras.ai/) - free daily quota
CEREBRAS_API_KEY=your_cerebras_api_key
CEREBRAS_MODEL=llama3.1-8b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

## SambaNova (https://cloud.sambanova.ai/) - free credits/developer tier
SAMBANOVA_API_KEY=your_sambanova_api_key
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1

## Gemini (Google AI Studio) - 무료 티어 추천
## Key 발급: https://aistudio.google.com/app/apikey
GOOGLE_AI_STUDIO_KEY=your_google_ai_studio_key
# 기본 추천 모델: gemini-flash-latest (무료/빠름)
GEMINI_MODEL=gemini-flash-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

## Pollinations (https://enter.pollinations.ai/api/docs)
## OpenAI-compatible endpoint: https://gen.pollinations.ai/v1/chat/completions
POLLINATIONS_API_KEY=your_pollinations_api_key
# Cheap default model recommendation: mistral (balanced) or nova-fast (cheapest)
POLLINATIONS_TEXT_MODEL=mistral
POLLINATIONS_BASE_URL=https://gen.pollinations.ai

# LLM failover policy (quota-aware)
# Enable automatic provider fallback when quota/rate-limit/server errors occur
LLM_FAILOVER_ENABLED=true
# Provider order used after preferred provider fails
LLM_FAILOVER_ORDER=gemini,pollinations,groq,openrouter,mistral,deepseek,cerebras,sambanova,huggingface,vllm
# HTTP status codes that trigger failover attempts
LLM_FAILOVER_ON_STATUS=429,503,504

# Database
# PostgreSQL connection string
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/aiopsboard

# Redis
REDIS_PASSWORD=password123
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0