# AI Ops Board Environment Variables

# Copy this file to .env and fill in the values

# === Port Configuration ===
FRONTEND_PORT=3005
BACKEND_PORT=8005
POSTGRES_PORT=5432

# Reddit API (https://www.reddit.com/prefs/apps)
# Create app: https://www.reddit.com/prefs/apps
# Select "script" type for personal use

# === Reddit App Registration Details ===
# App Name: AI Ops Board
# Description (앱 설명):
#   "Personal project to aggregate AI operation tips from Reddit/GitHub/HN
#    for self-learning. Non-commercial, no ads, no data reselling.
#    Posts are stored locally and used only for personal reference."
# About URL: (your project URL or leave empty)
# Redirect URI: http://localhost:8080

# === Reddit API Mode (requires approval) ===
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=AI-Ops-Board/1.0 (by /u/your_username)

# === Reddit RSS Mode (no approval needed) ===
# Set to True to use RSS feeds instead of API
# RSS works immediately without Reddit approval
REDDIT_USE_RSS=True
REDDIT_RSS_FEEDS=https://www.reddit.com/r/LocalLLaMA/.rss,https://www.reddit.com/r/ArtificialInteligence/.rss

# Crawl source control
# Only listed sources are allowed to run (API + scheduled tasks)
# Available: reddit, github, hn, youtube
CRAWL_ENABLED_SOURCES=reddit,github,hn,youtube

# YouTube allowed target list (comma-separated URLs)
# If empty, any URL is allowed.
YOUTUBE_TARGET_URLS=

# Minimal text thresholds for reliable LLM classification
MIN_CLASSIFIABLE_CONTENT_LEN=120
MIN_CLASSIFIABLE_SIGNAL_LEN=160

# LLM Providers

## Hugging Face (https://huggingface.co/settings/inference)
## Free tier - No GPU needed
HUGGINGFACE_TOKEN=your_huggingface_token

## Groq (https://console.groq.com/)
## Free tier available
GROQ_API_KEY=your_groq_api_key

## OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key

## Gemini (Google AI Studio) - 무료 티어 추천
## Key 발급: https://aistudio.google.com/app/apikey
GOOGLE_AI_STUDIO_KEY=your_google_ai_studio_key
# 기본 추천 모델: gemini-flash-latest (무료/빠름)
GEMINI_MODEL=gemini-flash-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

## Pollinations (https://enter.pollinations.ai/api/docs)
## OpenAI-compatible endpoint: https://gen.pollinations.ai/v1/chat/completions
POLLINATIONS_API_KEY=your_pollinations_api_key
# Cheap default model recommendation: mistral (balanced) or nova-fast (cheapest)
POLLINATIONS_TEXT_MODEL=mistral
POLLINATIONS_BASE_URL=https://gen.pollinations.ai

# Database
# PostgreSQL connection string
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/aiopsboard